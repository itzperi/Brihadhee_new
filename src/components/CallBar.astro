---
/**
 * Sticky mobile CTA bar (hidden from 900px up), rendered by Base.astro on every page.
 *   Dine-in pages:   Call | Menu & prices | Reserve table (online booking at /reserve-table/)
 *   Catering pages (mode="quote"): Call catering | WhatsApp quote | Get a quote (the page's #enquiry form)
 * Fixed 64px height with matching body padding (global.css), so it never covers the footer
 * and causes no layout shift. data-mode marks the page type (checked by scripts/seo-verify.mjs);
 * src/scripts/main.js names call and WhatsApp events by the number dialled.
 * Each accessible name starts with the visible label (WCAG 2.5.3), then adds the number.
 */
import { site, ROUTES, href, pageContact } from "../data/site.js";
import Icon from "./Icon.astro";

const { mode = "book", quoteAction } = Astro.props;
const quote = mode === "quote";
const { phone, hasPhone, hasWhatsApp, telHref, whatsappHref } = pageContact(Astro);
---

<nav class="callbar is-visible" id="callbar" data-mode={mode} aria-label="Quick actions">
  {hasPhone && (
    <a href={telHref} data-event="click_call" aria-label={`${quote ? "Call catering" : "Call"} ${phone}`}>
      <Icon name="phone" size={19} />
      {quote ? "Call catering" : "Call"}
    </a>
  )}
  {quote ? (
    hasWhatsApp && (
      <a href={`${whatsappHref}?text=${encodeURIComponent(`Hi ${site.name}, I'd like a catering quote. `)}`} target="_blank" rel="noopener" data-event="click_whatsapp">
        <Icon name="whatsapp" size={19} />
        WhatsApp quote
      </a>
    )
  ) : (
    <a href={href(ROUTES.menu)}>
      <Icon name="utensils" size={19} />
      Menu &amp; prices
    </a>
  )}
  {quote ? (
    <a href={quoteAction?.href ?? "#enquiry"} data-event="quote_cta_click" data-primary>
      <Icon name="mail" size={19} />
      {quoteAction?.shortLabel ?? quoteAction?.label ?? "Get a quote"}
    </a>
  ) : (
    <a href={href(ROUTES.reserve)} data-event="reserve_table_view_click" data-primary>
      <Icon name="clock" size={19} />
      Reserve table
    </a>
  )}
</nav>
