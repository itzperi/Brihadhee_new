---
/**
 * Compact Tamil summary (lang="ta") for /about/ and /faq/: the Tamil search terms
 * as labels, each answered with verified facts (src/data/faq-ta.js taSummary).
 * Static HTML, same definition-list styling as the at-a-glance box.
 */
import { taSummary } from "../data/faq-ta.js";
const { id = "tamil" } = Astro.props;
---

<section class="section" id={id} lang="ta" aria-labelledby={`${id}-title`}>
  <div class="container">
    <aside class="glance__box">
      <h2 class="glance__title" id={`${id}-title`}>பிரிஹதீ பற்றி தமிழில்</h2>
      <dl class="glance__list">
        {taSummary.map(([term, value]) => (
          <div class="glance__row">
            <dt>{term}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    </aside>
  </div>
</section>
