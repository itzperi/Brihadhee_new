---
import { site } from "../data/site.js";
const { title } = Astro.props;
---

<div class="location-map" data-location-map hidden>
  <template>
    <iframe src={site.maps.embed} title={title} width="600" height="450" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
  </template>
</div>
<noscript>
  <iframe src={site.maps.embed} title={title} width="600" height="450" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
</noscript>

<script>
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      const container = entry.target;
      const template = container.querySelector("template")!;
      container.replaceChildren(template.content.cloneNode(true));
      observer.unobserve(container);
    }
  }, { rootMargin: "100px" });
  document.querySelectorAll<HTMLDivElement>("[data-location-map]").forEach((container) => {
    container.hidden = false;
    observer.observe(container);
  });
</script>

<style>
  .location-map { width: 100%; height: 100%; }
  .location-map[hidden] { display: none; }
</style>
