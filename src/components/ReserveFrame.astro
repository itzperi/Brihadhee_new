---
/**
 * Frame for the Instagram ad booking funnel (/reserve-table/ and /reserve-table/tables/).
 * Distraction-free: no site nav, no mobile CallBar (the pages have their own
 * sticky bar), noindex and kept out of the sitemap so it never competes with
 * /book-a-table/ in search. Brand, address and phone come from the verified facts.
 */
import Base from "../layouts/Base.astro";
import Wordmark from "./Wordmark.astro";
import Icon from "./Icon.astro";
import { site, telHref } from "../data/site.js";
import { getFact, addressLine } from "../data/entity-truth.ts";
import { pageGraph, HOME_CRUMBS } from "../lib/schema.js";
import "../styles/reserve.css";

const { title, description, path, step } = Astro.props;
const phone = getFact("phone");
const hours = getFact("hours").short;
const root = { name: "Reserve a table", path: "/reserve-table/" };
const crumbs = path === root.path ? [...HOME_CRUMBS, root] : [...HOME_CRUMBS, root, { name: "Choose tables", path }];
const schema = pageGraph({ path, title, description, crumbs });
---

<Base title={title} description={description} path={path} noindex cta="none" schema={schema}>
  <header class="rv-head">
    <div class="rv-wrap rv-head__row">
      <span class="rv-brand">
        <Wordmark class="rv-brand__mark" />
        <span class="rv-brand__sub">Pure veg · Anna Nagar East</span>
        <span class="visually-hidden">{site.name}</span>
      </span>
      <a class="rv-head__call" href={telHref} aria-label={`Call ${phone}`}>
        <Icon name="phone" size={18} /> <span>Call</span>
      </a>
    </div>
    <ol class="rv-wrap rv-steps" aria-label="Booking steps">
      <li aria-current={step === 1 ? "step" : undefined} class:list={{ "is-done": step > 1 }}>1 · Time</li>
      <li aria-current={step === 2 ? "step" : undefined}>2 · Tables</li>
    </ol>
  </header>
  <main id="main" tabindex="-1" class="rv-main">
    <slot />
  </main>
  <footer class="rv-foot">
    <div class="rv-wrap">
      <p><strong>{site.name}</strong>, {addressLine()}</p>
      <p>Open daily, {hours} · <a href={telHref}>{phone}</a> · <a href={site.maps.directions} target="_blank" rel="noopener">Directions</a></p>
    </div>
  </footer>
</Base>
