---
/**
 * /reserve-table/: step 1 of the Instagram ad booking funnel (pick a date and one
 * or more 30-minute slots). Separate from /book-a-table/, which stays the partner
 * booking page for search and site navigation. State lives in the URL
 * (?date=…&slots=…), so Back from step 2 restores the choice. UTM parameters are
 * carried to step 2 and saved as the booking's traffic source.
 */
import ReserveFrame from "../../components/ReserveFrame.astro";
import { SLOT_GROUPS, slotLabel, BOOK_AHEAD_DAYS } from "../../lib/reserve.js";
import { site } from "../../data/site.js";

const path = "/reserve-table/";
const title = `Reserve a Table | ${site.name}, Anna Nagar East`;
const description = `Pick a date and time to reserve a table at ${site.name}, the pure veg South Indian restaurant in Anna Nagar East, Chennai.`;
---

<ReserveFrame title={title} description={description} path={path} step={1}>
  <div class="rv-wrap" data-reserve-time>
    <h1 class="rv-title">Reserve your table</h1>
    <p class="rv-lead">Choose a day and one or more 30-minute slots. Pick two slots for a one-hour meal.</p>

    <span class="rv-label" id="date-label">Date</span>
    <div class="rv-pills" role="group" aria-labelledby="date-label">
      <button type="button" class="rv-pill" data-day="0" aria-pressed="false">Today</button>
      <button type="button" class="rv-pill" data-day="1" aria-pressed="false">Tomorrow</button>
      <label class="visually-hidden" for="rv-date">Pick another date</label>
      <input class="rv-date" type="date" id="rv-date" />
    </div>
    <p class="rv-note" data-date-text aria-live="polite"></p>

    {SLOT_GROUPS.map((g) => (
      <section class="rv-group" aria-labelledby={`g-${g.id}`}>
        <div class="rv-group__head">
          <h2 id={`g-${g.id}`}>{g.label}</h2>
          <span>{g.slots.length} slots</span>
        </div>
        <div class="rv-slots">
          {g.slots.map((s) => (
            <button type="button" class="rv-slot" data-slot={s} aria-pressed="false">{slotLabel(s)}</button>
          ))}
        </div>
      </section>
    ))}
    <p class="rv-empty" data-none hidden>All of today's times have passed. Choose another date.</p>
    <p class="rv-note">Bookings open up to {BOOK_AHEAD_DAYS} days ahead. Each slot is 30 minutes.</p>
  </div>

  <div class="rv-bar">
    <div class="rv-wrap rv-bar__row">
      <p class="rv-bar__text" data-bar-text aria-live="polite">Choose at least one time slot.</p>
      <a class="btn btn--primary rv-cta" href="/reserve-table/tables/" data-continue aria-disabled="true" data-event="reserve_table_continue">
        Continue to Select Tables →
      </a>
    </div>
  </div>
</ReserveFrame>

<script>
  import { istNow, addDays, openSlots, firstOpenDate, parseSlots, dateLabel, slotLabel, BOOK_AHEAD_DAYS } from "../../lib/reserve.js";

  const root = document.querySelector("[data-reserve-time]");
  const pills = [...root.querySelectorAll("[data-day]")];
  const picker = root.querySelector("#rv-date");
  const slotBtns = [...root.querySelectorAll("[data-slot]")];
  const none = root.querySelector("[data-none]");
  const dateText = root.querySelector("[data-date-text]");
  const barText = document.querySelector("[data-bar-text]");
  const cta = document.querySelector("[data-continue]");

  const params = new URLSearchParams(location.search);
  const today = istNow().date;
  picker.min = today;
  picker.max = addDays(today, BOOK_AHEAD_DAYS);

  let date = params.get("date");
  if (!date || !openSlots(date).length) date = firstOpenDate();
  let selected = new Set(parseSlots(params.get("slots")));

  function nextUrl() {
    const q = new URLSearchParams(location.search);
    q.set("date", date);
    q.set("slots", [...selected].sort().join(","));
    return q;
  }

  function render() {
    const open = new Set(openSlots(date));
    for (const s of selected) if (!open.has(s)) selected.delete(s);
    for (const b of slotBtns) {
      const s = b.dataset.slot;
      b.disabled = !open.has(s);
      b.setAttribute("aria-pressed", String(selected.has(s)));
      b.closest(".rv-group").hidden = ![...b.closest(".rv-group").querySelectorAll("[data-slot]")].some((x) => open.has(x.dataset.slot));
    }
    none.hidden = open.size > 0;
    pills.forEach((p) => p.setAttribute("aria-pressed", String(addDays(today, Number(p.dataset.day)) === date)));
    picker.value = date;
    picker.classList.toggle("is-active", !pills.some((p) => p.getAttribute("aria-pressed") === "true"));
    dateText.textContent = dateLabel(date);

    const list = [...selected].sort();
    if (list.length) {
      barText.innerHTML = "";
      const strong = document.createElement("strong");
      strong.textContent = dateLabel(date);
      barText.append(strong, ` · ${list.map(slotLabel).join(", ")}`);
    } else {
      barText.textContent = "Choose at least one time slot.";
    }
    const q = nextUrl();
    cta.setAttribute("aria-disabled", String(!list.length));
    cta.href = `/reserve-table/tables/?${q}`;
    history.replaceState(null, "", `${location.pathname}?${q}`);
  }

  pills.forEach((p) => p.addEventListener("click", () => {
    date = addDays(today, Number(p.dataset.day));
    render();
  }));
  picker.addEventListener("change", () => {
    if (picker.value && picker.value >= picker.min && picker.value <= picker.max) date = picker.value;
    render();
  });
  slotBtns.forEach((b) => b.addEventListener("click", () => {
    const s = b.dataset.slot;
    selected.has(s) ? selected.delete(s) : selected.add(s);
    render();
  }));
  cta.addEventListener("click", (e) => {
    if (!selected.size) {
      e.preventDefault();
      e.stopImmediatePropagation();
      barText.textContent = "Choose at least one time slot to continue.";
    }
  }, { capture: true });

  render();
</script>
