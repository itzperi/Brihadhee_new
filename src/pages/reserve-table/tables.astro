---
/**
 * /reserve-table/tables/: step 2 of the booking funnel. Reads ?date=…&slots=…
 * from step 1 and shows the dining room as the owner sketched it (20 Nov 2026):
 * tables D1–D8 with their chairs. Guests tap single seats (or a table to take
 * all its free seats). Seats already booked for an overlapping slot come from
 * GET /api/book-table and are greyed out and cannot be chosen. Name and phone are
 * taken in a dialog and posted to /api/book-table, which writes the Google
 * Sheet; the confirmation shows only after the sheet accepted the row.
 */
import ReserveFrame from "../../components/ReserveFrame.astro";
import Icon from "../../components/Icon.astro";
import { TABLES } from "../../lib/reserve.js";
import { site, telHref } from "../../data/site.js";
import { getFact } from "../../data/entity-truth.ts";

const path = "/reserve-table/tables/";
const title = `Choose Your Seats | ${site.name}, Anna Nagar East`;
const description = `Choose your seats on the floor plan and confirm your booking at ${site.name}, Anna Nagar East, Chennai.`;
const phone = getFact("phone");
const seat = (t, n) => `${t.id}-${n}`;
---

<ReserveFrame title={title} description={description} path={path} step={2}>
  <div class="rv-wrap" data-reserve-tables>
    <div data-pick>
      <h1 class="rv-title">Choose your seats</h1>
      <div class="rv-summary">
        <dl>
          <dt>Date</dt><dd data-sum-date>…</dd>
          <dt>Time</dt><dd data-sum-time>…</dd>
        </dl>
        <a href="/reserve-table/" data-back>Change</a>
      </div>
      <p class="rv-alert" data-invalid hidden>
        That date or time is no longer available. <a href="/reserve-table/">Choose a time again</a>.
      </p>

      <span class="rv-label" id="floor-label">Tap the seats you want, or tap a table for all its free seats</span>
      <ul class="rv-legend" aria-label="Seat colours">
        <li><span class="rv-seat rv-seat--key" aria-hidden="true"></span> Available</li>
        <li><span class="rv-seat rv-seat--key is-picked" aria-hidden="true"></span> Selected</li>
        <li><span class="rv-seat rv-seat--key is-booked" aria-hidden="true"></span> Booked</li>
      </ul>

      <div class="rv-room" role="group" aria-labelledby="floor-label">
        <span class="rv-room__door rv-room__entrance">Entrance</span>
        <span class="rv-room__fixture rv-room__cash">Cash counter</span>
        <span class="rv-room__fixture rv-room__wash">Wash</span>
        <span class="rv-room__door rv-room__kitchen">Kitchen</span>
        {TABLES.map((t) => (
          <div class:list={["rv-tbl", t.seats === 6 && "rv-tbl--ends"]} style={`--x:${t.x}%;--y:${t.y}%`} data-tbl={t.id}>
            <div class="rv-tbl__row">
              {[1, 2].map((n) => <button type="button" class="rv-seat" data-seat={seat(t, n)} aria-pressed="false" aria-label={`Table ${t.id}, seat ${n}`}>{n}</button>)}
            </div>
            <div class="rv-tbl__mid">
              {t.seats === 6 && <button type="button" class="rv-seat" data-seat={seat(t, 5)} aria-pressed="false" aria-label={`Table ${t.id}, seat 5`}>5</button>}
              <button type="button" class="rv-tbl__top" data-table={t.id} aria-label={`Table ${t.id}, ${t.label}: choose all free seats`}>
                <strong>{t.id}</strong><small>{t.seats === 6 ? "4+2" : "4"}</small>
              </button>
              {t.seats === 6 && <button type="button" class="rv-seat" data-seat={seat(t, 6)} aria-pressed="false" aria-label={`Table ${t.id}, seat 6`}>6</button>}
            </div>
            <div class="rv-tbl__row">
              {[3, 4].map((n) => <button type="button" class="rv-seat" data-seat={seat(t, n)} aria-pressed="false" aria-label={`Table ${t.id}, seat ${n}`}>{n}</button>)}
            </div>
          </div>
        ))}
      </div>
      <p class="rv-note" data-avail-note aria-live="polite"></p>
      <p class="rv-alert" data-page-error role="alert" hidden></p>
    </div>

    <section class="rv-confirm" data-done hidden tabindex="-1" aria-labelledby="done-title">
      <span class="rv-confirm__badge"><Icon name="check" size={18} /> Booking received</span>
      <h2 id="done-title">Your seats are booked</h2>
      <dl>
        <dt>Booking ID</dt><dd class="rv-confirm__id" data-c="bookingId"></dd>
        <dt>Date</dt><dd data-c="date"></dd>
        <dt>Time</dt><dd data-c="timings"></dd>
        <dt>Seats</dt><dd data-c="seats"></dd>
        <dt>Name</dt><dd data-c="name"></dd>
        <dt>Phone</dt><dd data-c="phone"></dd>
      </dl>
      <p class="rv-note">Show this Booking ID at the counter. The reception team may call you on this number before your visit.</p>
      <div class="rv-confirm__actions">
        <a class="btn btn--primary" href={telHref}><Icon name="phone" size={17} /> Call Reception ({phone})</a>
        <a class="btn btn--ghost" href={site.maps.directions} target="_blank" rel="noopener"><Icon name="navigation" size={17} /> Directions to {site.name}, Anna Nagar East</a>
      </div>
    </section>
  </div>

  <div class="rv-bar" data-bar>
    <div class="rv-wrap rv-bar__row">
      <p class="rv-bar__text" data-bar-text aria-live="polite">Choose at least one seat.</p>
      <button type="button" class="btn btn--primary rv-cta" data-book disabled>Book Seats</button>
    </div>
  </div>

  <dialog class="rv-dialog" data-dialog aria-labelledby="dlg-title">
    <form data-form novalidate>
      <h2 id="dlg-title">Your details</h2>
      <p class="rv-note" data-dlg-sum></p>
      <div class="rv-field">
        <label for="rv-name">Full name</label>
        <input id="rv-name" name="name" autocomplete="name" required maxlength="80" aria-describedby="err-name" />
        <p class="rv-err" id="err-name" data-err="name"></p>
      </div>
      <div class="rv-field">
        <label for="rv-phone">Mobile number</label>
        <div class="rv-phone">
          <span aria-hidden="true">+91</span>
          <input id="rv-phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" required maxlength="14" placeholder="98765 43210" aria-describedby="err-phone" />
        </div>
        <p class="rv-err" id="err-phone" data-err="phone"></p>
      </div>
      <div class="rv-hp" aria-hidden="true">
        <label for="rv-company">Company</label>
        <input id="rv-company" name="company" tabindex="-1" autocomplete="off" />
      </div>
      <p class="rv-alert" data-form-error role="alert" hidden></p>
      <div class="rv-dialog__actions">
        <button type="submit" class="btn btn--primary rv-cta" data-submit>
          <span class="rv-spin" aria-hidden="true"></span><span data-submit-label>Confirm Reservation</span>
        </button>
        <button type="button" class="btn btn--ghost" data-cancel>Back</button>
      </div>
    </form>
  </dialog>
</ReserveFrame>

<script>
  import { openSlots, parseSlots, dateLabel, slotLabel, normalisePhone, seatSummary, sortSeats, SEAT_COUNT } from "../../lib/reserve.js";

  const root = document.querySelector("[data-reserve-tables]");
  const $ = (s, el = document) => el.querySelector(s);
  const seatBtns = [...root.querySelectorAll("[data-seat]")];
  const tableBtns = [...root.querySelectorAll("[data-table]")];
  const bar = $("[data-bar]");
  const barText = $("[data-bar-text]");
  const book = $("[data-book]");
  const dialog = $("[data-dialog]");
  const form = $("[data-form]");
  const submit = $("[data-submit]");
  const formError = $("[data-form-error]");
  const pageError = $("[data-page-error]");
  const availNote = $("[data-avail-note]");

  const params = new URLSearchParams(location.search);
  const date = params.get("date") || "";
  const slots = parseSlots(params.get("slots"));
  const back = new URLSearchParams(location.search);
  $("[data-back]").href = `/reserve-table/?${back}`;
  $("[data-invalid] a").href = `/reserve-table/?${back}`;

  const source = (() => {
    const s = params.get("utm_source"), m = params.get("utm_medium"), c = params.get("utm_campaign");
    if (s) return [s, m, c].filter(Boolean).join(" / ");
    if (params.get("fbclid")) return "facebook/instagram (fbclid)";
    if (params.get("ref")) return `website: ${params.get("ref")}`;
    try {
      const ref = document.referrer && new URL(document.referrer).hostname;
      if (ref && ref !== location.hostname) return `referral: ${ref}`;
    } catch {}
    return "direct";
  })().slice(0, 120);

  const open = new Set(openSlots(date));
  const valid = slots.length > 0 && slots.every((s) => open.has(s));
  const timeText = slots.map(slotLabel).join(", ");
  $("[data-sum-date]").textContent = valid ? dateLabel(date) : "—";
  $("[data-sum-time]").textContent = valid ? timeText : "—";
  if (!valid) $("[data-invalid]").hidden = false;

  const selected = new Set();
  let taken = new Set();
  let sending = false;
  const plural = (n, w) => `${n} ${w}${n === 1 ? "" : "s"}`;
  const seatsAt = (tableId) => seatBtns.filter((b) => b.dataset.seat.startsWith(`${tableId}-`));

  function render() {
    for (const b of seatBtns) {
      const id = b.dataset.seat;
      const isTaken = taken.has(id);
      if (isTaken) selected.delete(id);
      const [t, n] = id.split("-");
      b.disabled = !valid || isTaken;
      b.classList.toggle("is-booked", isTaken);
      b.classList.toggle("is-picked", selected.has(id));
      b.setAttribute("aria-pressed", String(selected.has(id)));
      b.setAttribute("aria-label", `Table ${t}, seat ${n}${isTaken ? ", booked" : ""}`);
    }
    for (const t of tableBtns) {
      const free = seatsAt(t.dataset.table).filter((b) => !taken.has(b.dataset.seat));
      t.disabled = !valid || !free.length;
      t.classList.toggle("is-full", !free.length);
      t.classList.toggle("is-picked", free.length > 0 && free.every((b) => selected.has(b.dataset.seat)));
    }
    const list = sortSeats([...selected]);
    book.disabled = !valid || !list.length;
    barText.textContent = list.length ? `${plural(list.length, "Seat")} Selected: ${seatSummary(list)}` : "Choose at least one seat.";
  }

  seatBtns.forEach((b) => b.addEventListener("click", () => {
    const id = b.dataset.seat;
    selected.has(id) ? selected.delete(id) : selected.add(id);
    pageError.hidden = true;
    render();
  }));
  tableBtns.forEach((t) => t.addEventListener("click", () => {
    const free = seatsAt(t.dataset.table).map((b) => b.dataset.seat).filter((id) => !taken.has(id));
    const all = free.every((id) => selected.has(id));
    free.forEach((id) => (all ? selected.delete(id) : selected.add(id)));
    pageError.hidden = true;
    render();
  }));

  async function loadAvailability() {
    if (!valid) return;
    availNote.textContent = "Checking which seats are free…";
    try {
      const res = await fetch(`/api/book-table?date=${encodeURIComponent(date)}`, { headers: { Accept: "application/json" } });
      const data = await res.json();
      if (!data.ok) throw new Error();
      taken = new Set(slots.flatMap((s) => data.taken[s] || []));
      availNote.textContent = taken.size >= SEAT_COUNT
        ? "All seats are booked for this time. Choose another time or call reception."
        : taken.size ? "Grey seats are already booked for your time." : "";
    } catch {
      availNote.textContent = "";
    }
    render();
  }

  book.addEventListener("click", () => {
    if (book.disabled) return;
    $("[data-dlg-sum]").textContent = `${dateLabel(date)} · ${timeText} · ${plural(selected.size, "seat")}: ${seatSummary([...selected])}`;
    formError.hidden = true;
    dialog.showModal();
    $("#rv-name").focus();
  });
  $("[data-cancel]").addEventListener("click", () => dialog.close());

  function fieldError(name, msg) {
    const input = form.elements[name];
    $(`[data-err="${name}"]`).textContent = msg || "";
    input.setAttribute("aria-invalid", msg ? "true" : "false");
    return !msg;
  }

  function setLoading(on) {
    sending = on;
    submit.disabled = on;
    submit.classList.toggle("is-loading", on);
    $("[data-submit-label]").textContent = on ? "Confirming…" : "Confirm Reservation";
  }

  function showDone(b) {
    const set = (k, v) => ($(`[data-c="${k}"]`).textContent = v);
    set("bookingId", b.bookingId);
    set("date", dateLabel(b.date));
    set("timings", b.timings);
    set("seats", `${b.seatCount}: ${b.tableNumbers}`);
    set("name", b.name);
    set("phone", b.phone);
    dialog.close();
    $("[data-pick]").hidden = true;
    bar.hidden = true;
    document.querySelector(".rv-steps")?.setAttribute("hidden", "");
    const done = $("[data-done]");
    done.hidden = false;
    done.focus();
    window.scrollTo(0, 0);
    try { sessionStorage.setItem("brihadhee:lastBooking", JSON.stringify(b)); } catch {}
    if (typeof window.gtag === "function") window.gtag("event", "reserve_table_submit", { seats: b.seatCount, tables: b.tableCount, page_path: location.pathname });
    if (typeof window.fbq === "function") window.fbq("track", "Schedule", { content_name: "reserve-table", num_items: b.seatCount });
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (sending) return;
    formError.hidden = true;
    const name = form.elements.name.value.trim();
    const phone = normalisePhone(form.elements.phone.value);
    const ok = [
      fieldError("name", name.length < 2 ? "Enter your full name." : ""),
      fieldError("phone", phone ? "" : "Enter a 10-digit mobile number, e.g. 98765 43210."),
    ].every(Boolean);
    if (!ok) {
      form.querySelector('[aria-invalid="true"]')?.focus();
      return;
    }

    setLoading(true);
    try {
      const res = await fetch("/api/book-table", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ date, slots, seats: sortSeats([...selected]), name, phone, source, company: form.elements.company.value }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.ok && data.booking) return showDone(data.booking);
      if (res.status === 409 && data.error === "taken") {
        const lost = sortSeats(data.taken.map((t) => t.seat).filter(Boolean));
        lost.forEach((id) => taken.add(id));
        render();
        dialog.close();
        pageError.textContent = `Sorry, ${seatSummary(lost)} ${lost.length === 1 ? "was" : "were"} just booked by someone else. Your other seats are still selected; choose again.`;
        pageError.hidden = false;
        return;
      }
      if (res.status === 422 && data.errors) {
        if (data.errors.name) fieldError("name", data.errors.name);
        if (data.errors.phone) fieldError("phone", data.errors.phone);
        const other = Object.entries(data.errors).filter(([k]) => k !== "name" && k !== "phone").map(([, v]) => v);
        if (other.length) {
          formError.textContent = other.join(" ");
          formError.hidden = false;
        }
        return;
      }
      throw new Error(String(res.status));
    } catch {
      formError.textContent = "We could not save your booking. Please try again, or call reception on the number at the top of the page.";
      formError.hidden = false;
    } finally {
      setLoading(false);
    }
  });

  render();
  loadAvailability();
</script>
