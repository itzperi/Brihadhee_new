---
/**
 * /guides/karaikudi-vs-nellai-veg-cuisine/: comparison explainer (Nellai coconut-milk
 * dishes vs Karaikudi spice blends), linked to the Nellai guide, the menu and event
 * catering. Schema: Article + BreadcrumbList only (no FAQPage, no Review).
 * Copy and prices: src/data/guides.js (karaikudiNellaiGuide) from menu-canonical.ts.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import PageHeader from "../../components/PageHeader.astro";
import { karaikudiNellaiGuide as page } from "../../data/guides.js";
import { longDate } from "../../data/entity-truth.ts";
import { pageGraph, articleSchema, HOME_CRUMBS } from "../../lib/schema.js";
import { ROUTES, href, pageContentUpdated, site } from "../../data/site.js";
import { linkify } from "../../lib/inline-links.js";

const modified = pageContentUpdated(page.path);
const schema = pageGraph({
  path: page.path,
  title: page.title,
  description: page.description,
  crumbs: [...HOME_CRUMBS, { name: "Menu", path: ROUTES.menu }, { name: "Karaikudi vs Nellai", path: page.path }],
  extras: [
    articleSchema({
      path: page.path,
      headline: page.h1,
      description: page.description,
      datePublished: page.published,
      image: "/images/meals.webp",
      about: ["Tirunelveli cuisine", "Chettinad cuisine", "Sodhi", "Ulundhu kali", "Karaikudi Paneer Poppers"],
    }),
  ],
});
---

<Base title={page.title} description={page.description} path={page.path} schema={schema}>
  <Nav homeBase={href("/")} />
  <main id="main" tabindex="-1">
    <PageHeader eyebrow="Guide · Tamil vegetarian food" h1={page.h1} intro={page.intro} menuHref={href(ROUTES.menu)} />
    <p class="container page-head__date">By <a href={href(ROUTES.about)}>{site.name}</a> · Published <time datetime={page.published}>{longDate(page.published)}</time>{modified > page.published && <> · Updated <time datetime={modified}>{longDate(modified)}</time></>}</p>

    <article class="guide">
      <section class="section" id="compare" aria-labelledby="compare-title">
        <div class="container guide__body">
          <h2 class="section__title" id="compare-title">Nellai and Karaikudi Food Side by Side</h2>
          <table class="menu-page__table">
            <caption class="visually-hidden">{page.table.caption}</caption>
            <thead><tr>{page.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>
              {page.table.rows.map(([first, ...rest]) => (
                <tr><th scope="row">{first}</th>{rest.map((c) => <td set:html={linkify(c)} />)}</tr>
              ))}
            </tbody>
          </table>
          <p class="field__hint">Prices from the current menu, before 5% GST.</p>
        </div>
      </section>
      {page.sections.map((sec, i) => (
        <section class={`section${i % 2 ? "" : " section--tint"}`} id={sec.id} aria-labelledby={`${sec.id}-title`}>
          <div class="container guide__body">
            <h2 class="section__title" id={`${sec.id}-title`}>{sec.title}</h2>
            <p class="section__lead" set:html={linkify(sec.answer)} />
            {sec.paras.map((p) => <p set:html={linkify(p)} />)}
          </div>
        </section>
      ))}
    </article>
  </main>
  <Footer homeBase={href("/")} />
</Base>
