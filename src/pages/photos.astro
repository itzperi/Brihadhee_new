---
/**
 * /photos/: every real food photo in public/images, grouped by dish, with the
 * menu price range for that dish. Captions describe only what the photo shows;
 * prices come from menu-canonical.ts and link to the menu. There are no photos
 * of Paanai Parotta, the dining room or a live catering counter yet
 * (public/images/interior.* is a placeholder), so those groups are left out.
 */
import SpokePage from "../components/SpokePage.astro";
import { photosPage } from "../data/spokes.js";
import { site, responsive, ROUTES, href } from "../data/site.js";
import { category, priceRange, rupees, filterCoffee, byo, summarise } from "../lib/menu-facts.js";

const { hero, gallery } = site.media;
const find = (name, list) => list.find((m) => m.src.includes(`/images/${name}.webp`));
const batters = summarise(byo.steps.find((s) => s.name === "Batter").options);
const box = (name) => ({ ...responsive(name, 1200), width: 1200, height: 1200 });

const groups = [
  {
    id: "dosa",
    title: "Dosa",
    price: `Classic dosas ${priceRange(category("dosa"))}; build-your-own batters ${priceRange(batters)}, before 5% GST`,
    link: { label: "Build your own dosa", href: href(ROUTES.dosa) },
    photos: [
      { ...hero, caption: "Folded dosa with three sides" },
      { ...find("dosa", gallery), caption: "Dosa with chutneys on a banana leaf" },
    ],
  },
  {
    id: "meals",
    title: "Banana-leaf meals and idiyappam",
    price: `Lunch meals ${priceRange(category("lunch"))}; idiyappam ${priceRange(category("idiyappam"))}, before 5% GST`,
    link: { label: "Lunch and Nellai meals", href: href(ROUTES.lunch) },
    photos: [
      { ...find("meals", gallery), caption: "South Indian meal on a round banana leaf" },
      { ...find("idiyappam", gallery), caption: "Idiyappam with coconut milk" },
    ],
  },
  {
    id: "coffee-desserts",
    title: "Filter coffee and desserts",
    price: `Filter coffee ${rupees(filterCoffee.price)}, before 5% GST`,
    link: { label: "The Coffee Bar", href: `${href(ROUTES.home)}#coffee-bar` },
    photos: [
      { ...find("coffee", gallery), caption: "Coffee in a steel tumbler and davara" },
      { ...find("sweets", gallery), caption: "Dessert with chocolate sauce in a brass bowl" },
    ],
  },
  {
    id: "packed-meals",
    title: "Packed office meals",
    price: "Catering is quoted per plate for each order",
    link: { label: "Corporate catering in Chennai", href: href(ROUTES.corporateCatering) },
    photos: [
      { ...box("meal-box-rice"), alt: "Packed rice meal with a vegetarian side dish in a two-part box", caption: "Packed rice meal with a vegetarian side" },
      { ...box("meal-box-roti"), alt: "Packed phulkas with a dal in a two-part box", caption: "Packed phulkas with dal" },
    ],
  },
].map((g) => ({ ...g, photos: g.photos.filter((p) => p?.src) }));
---

<SpokePage page={photosPage}>
  {groups.map((g, gi) => (
    <section class={`section${gi % 2 ? " section--tint" : ""}`} id={g.id} aria-labelledby={`${g.id}-title`}>
      <div class="container">
        <h2 class="section__title" id={`${g.id}-title`}>{g.title}</h2>
        <p class="section__lead">{g.price}. <a href={g.link.href}>{g.link.label}</a>.</p>
        <div class="photos__grid">
          {g.photos.map((p) => (
            <figure class="photos__item">
              <img
                src={p.src}
                srcset={p.srcset}
                sizes="(max-width: 700px) 92vw, 45vw"
                width={p.width}
                height={p.height}
                alt={p.alt}
                loading="lazy"
                decoding="async"
              />
              <figcaption>{p.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  ))}
</SpokePage>
